{
  "name": "@virtality/socket",
  "version": "1.0.0",
  "description": "Express server for real time communication between the Frontend and the VR headset.",
  "main": "app.js",
  "scripts": {
    "dev": "doppler run -- tsx watch ./src/app.ts --host 0.0.0.0",
    "dev_sim": "SIM=true doppler run -- tsx watch ./src/app.ts",
    "test_client": "tsx watch --env-file=.env src/tests/test_client.ts ",
    "build": "tsc --build",
    "start": "node --env-file=.env ./dist/src/app.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.23.0",
  "author": "Stelios Pnevmatikakis",
  "license": "ISC",
  "dependencies": {
    "@virtality/shared": "workspace:*",
    "express": "5.1.0",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@virtality/typescript-config": "workspace:*",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  }
}
