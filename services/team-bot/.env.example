# Copy to .env for local development (`pnpm dev:team-bot`).
# Production values live in the infra repo: team-bot/.env.production

ENV=development

# WhatsApp Cloud API (Meta App Dashboard → WhatsApp → API Setup)
# Any string you choose; paste the same value into the webhook "Verify token".
WHATSAPP_VERIFY_TOKEN=
# App Dashboard → App settings → Basic → App secret. Signs every webhook POST.
WHATSAPP_APP_SECRET=
# System User access token with whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_API_VERSION=v23.0

# Comma-separated sender numbers allowed to create issues, digits only with
# country code and no "+" (the format WhatsApp sends), e.g. 306912345678.
TEAM_BOT_ALLOWED_SENDERS=

# Linear (Settings → Security & access → Personal API keys)
LINEAR_API_KEY=
# Settings → Teams → <team> → copy the team ID (UUID), or query `teams` in the API.
LINEAR_TEAM_ID=

# PORT=8080
# OTEL_LOGS_ENABLED=false
