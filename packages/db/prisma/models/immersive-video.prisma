// Immersive Video catalog and headset-written Library Mirror.

enum ImmersiveVideoActivity {
  CYCLING
  WALKING
}

enum ImmersiveVideoCatalogState {
  Draft
  Uploading
  Verifying
  Published
  Republishing
  Unpublished
}

enum DeviceVideoStatus {
  /// Console intent: the physio asked for a download the headset has not yet
  /// acknowledged. Never reported by a headset; survives a full Library State
  /// replace until the headset reports the video or the physio cancels.
  requested
  downloading
  paused
  ready
  failed
}

enum DeviceVideoFailureReason {
  insufficient_storage
  network
  checksum_mismatch
  cancelled
  url_expired
  unavailable
}

model ImmersiveVideo {
  id          String                      @id @default(cuid())
  title       String                      @default("")
  activity    ImmersiveVideoActivity      @default(CYCLING)
  description String?
  state       ImmersiveVideoCatalogState  @default(Draft)
  priorState  ImmersiveVideoCatalogState?

  version      Int     @default(0)
  objectKey    String? @unique
  sizeBytes    BigInt?
  checksum     String?
  durationSec  Int?
  filename     String?
  thumbnailKey String?

  uploadId          String? @unique
  uploadObjectKey   String?
  uploadFilename    String?
  uploadSizeBytes   BigInt?
  uploadDurationSec Int?

  verifyFailedAt DateTime? @db.Timestamp(6)
  publishedAt    DateTime? @db.Timestamp(6)
  createdAt      DateTime  @default(now()) @db.Timestamp(6)
  updatedAt      DateTime  @updatedAt @db.Timestamp(6)

  @@index([state])
  @@index([updatedAt])
}

/// Header of one headset's Library Mirror, written by the console from the
/// headset's socket events (ADR 0013). Keyed by Headset Identity
/// (`Device.deviceId`), not `Device.id`, and has no FK to Device: re-pairing
/// must not move or clear the rows, and the retention job owns deletion.
/// `freeBytes` is null until the headset has reported Library State once.
model DeviceVideoReport {
  deviceId   String   @id
  freeBytes  BigInt?
  reportedAt DateTime @db.Timestamp(6)

  videos DeviceVideo[]
}

/// One Library State entry in a Library Mirror snapshot. No FK to
/// ImmersiveVideo: a headset may still hold a file the catalog no longer has.
model DeviceVideo {
  deviceId        String
  videoId         String
  status          DeviceVideoStatus
  version         Int?
  bytesDownloaded BigInt?
  sizeBytes       BigInt?
  reason          DeviceVideoFailureReason?

  report DeviceVideoReport @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  @@id([deviceId, videoId])
  @@index([videoId, version])
}
