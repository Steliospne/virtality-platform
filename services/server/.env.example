# Copy to .env and fill from the team vault when needed.
# See docs/onboarding/README.md

ENV=development
NEXT_PUBLIC_ENV=development

# Local Postgres from `pnpm db:up`
CONSOLE_DATABASE_URL=postgresql://devuser:devpass@localhost:5434/devdb

# Better Auth (generate a long random string for local use)
BETTER_AUTH_SECRET=dev-only-change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:8080

# Same value as apps/website REVALIDATE_SECRET
REVALIDATE_SECRET=dev-revalidate-secret

# Set to true for container Node listen (local uses ENV=development)
LISTEN=

# Optional: Google OAuth (omit for email/password-only local auth)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: Stripe (omit in development to skip the Better Auth Stripe plugin)
# STRIPE_SECRET_KEY=
# For local `stripe listen --forward-to localhost:8080/api/v1/auth/stripe/webhook`,
# use the signing secret from `stripe listen --print-secret`, not the Dashboard endpoint secret.
# STRIPE_WEBHOOK_SECRET=

# Email (needed for new sign-ups / verification; seeded admin is already verified)
# Set EMAIL_LOCAL_TESTING=true to skip real SMTP entirely: a throwaway Ethereal
# test account is used instead, and every send logs a preview link to the console.
EMAIL_LOCAL_TESTING=true
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# FROM_MAIL_ALIAS=
# FROM_AUTH_ALIAS=

# Optional Cloudflare TURN (WebRTC)
# CLOUDFLARE_TURN_TOKEN_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# CLOUDFLARE_TURN_TTL_SECONDS=

# Optional additional recipients; info@virtality.app is always notified.
WAITLIST_NOTIFY_EMAIL=

# Customer onboarding booking link used in the welcome email.
WAITLIST_ONBOARDING_URL=https://cal.com/virtality
