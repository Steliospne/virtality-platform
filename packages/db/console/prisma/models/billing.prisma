// Subscription and Billing Domain
// Fields align with Better Auth Stripe subscription schema (success/webhook sync).

model Subscription {
  id                   String    @id
  plan                 String
  referenceId          String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String
  periodStart          DateTime?
  periodEnd            DateTime?
  cancelAtPeriodEnd    Boolean?
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  seats                Int?
  trialStart           DateTime?
  trialEnd             DateTime?
  billingInterval      String?
  stripeScheduleId     String?
}

model WaitingList {
  id        String    @id
  email     String
  plan      String?
  createdAt DateTime  @db.Timestamp(6)
  deletedAt DateTime? @db.Timestamp(6)
}

/// Issuance/consume store for Trial Redeem Codes. Entitlement clock lives on
/// synced Stripe Subscription rows, not on this model.
model TrialRedeemCode {
  id        Int                    @id @default(autoincrement())
  code      String                 @unique
  status    TrialRedeemCodeStatus  @default(unused)
  trialDays Int                    @default(14)
  note      String?
  createdAt DateTime               @db.Timestamp(6)
  usedAt    DateTime?              @db.Timestamp(6)
  usedBy    String?

  usedByUser User? @relation(fields: [usedBy], references: [id], onDelete: SetNull)
}
