{
  "name": "@virtality/team-bot",
  "version": "1.0.0",
  "description": "WhatsApp bot that lets the team create Linear issues from chat",
  "main": "./dist/index.js",
  "type": "module",
  "scripts": {
    "dev:bot": "tsx watch --env-file-if-exists=.env ./src/index.ts",
    "build": "rimraf dist && tsc",
    "start": "node ./dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "1.19.9",
    "@virtality/shared": "workspace:*",
    "hono": "4.11.9",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@virtality/typescript-config": "workspace:*",
    "rimraf": "6.1.2",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  }
}
