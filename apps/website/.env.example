# Shared with services/server — required for POST /api/revalidate
ENV=development
NEXT_PUBLIC_ENV=development

# PostHog (Website project). Missing NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN
# disables analytics; do not omit in real local/prod envs.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

REVALIDATE_SECRET=dev-revalidate-secret
