{
  "name": "@virtality/server",
  "version": "1.0.0",
  "description": "New server for the Virtality platform",
  "main": "./dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "doppler run -- tsx --watch ./src/index.ts",
    "build": "rimraf dist && tsc",
    "start": "node ./dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "1.19.9",
    "@prisma/client": "7.2.0",
    "@virtality/auth": "workspace:*",
    "@virtality/db": "workspace:*",
    "@virtality/orpc": "workspace:*",
    "@virtality/shared": "workspace:*",
    "@virtality/ui": "workspace:*",
    "hono": "4.11.9",
    "node-cron": "4.2.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/node-cron": "3.0.11",
    "@virtality/typescript-config": "workspace:*",
    "stripe": "18.5.0",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  }
}
