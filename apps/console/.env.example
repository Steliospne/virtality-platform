# Copy to .env and fill from the team vault when needed.
# See docs/onboarding/README.md

NEXT_PUBLIC_ENV=development
ENV=development

# Same DB as packages/db (required for console proxy / Prisma)
CONSOLE_DATABASE_URL=postgresql://devuser:devpass@localhost:5434/devdb

# Optional analytics
# NEXT_PUBLIC_POSTHOG_KEY=

# Optional CDN / uploads
# NEXT_PUBLIC_CDN_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=

# Optional Discord bug reports
# DISCORD_WEBHOOK_URL=
