{
  "name": "@virtality/db",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./dist/index.js"
    },
    "./definitions": {
      "types": "./prisma/generated/zod/schemas/index.ts",
      "default": "./dist/prisma/generated/zod/schemas/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate --config ./prisma.config.ts",
    "build": "pnpm generate && rimraf ./dist && tsc",
    "reset": "doppler run -- prisma migrate reset --config ./prisma.config.ts && doppler run -- prisma db seed --config ./prisma.config.ts",
    "migrate:dev": "doppler run -- prisma migrate dev --config ./prisma.config.ts && doppler run -- prisma db seed --config ./prisma.config.ts",
    "migrate:deploy": "prisma migrate deploy --config ./prisma.config.ts",
    "seed": "doppler run -- prisma db seed --config ./prisma.config.ts",
    "studio": "doppler run -- prisma studio --config ./prisma.config.ts",
    "migrate:programs-presets": "doppler run -- tsx scripts/migrate-programs-and-presets.ts",
    "migrate:programs-presets:dry-run": "doppler run -- tsx scripts/migrate-programs-and-presets.ts --dry-run",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@virtality/shared": "workspace:*",
    "better-auth": "1.5.5",
    "dotenv": "17.2.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@virtality/eslint-config": "workspace:*",
    "@virtality/typescript-config": "workspace:*",
    "eslint": "9.39.2",
    "prisma": "7.10.0",
    "prisma-zod-generator": "2.1.4",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  }
}
