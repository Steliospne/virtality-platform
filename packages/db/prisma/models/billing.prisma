// Subscription and Billing Domain
// Fields align with Better Auth Stripe subscription schema (success/webhook sync).

model Subscription {
  id                   String    @id
  plan                 String
  referenceId          String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String
  periodStart          DateTime?
  periodEnd            DateTime?
  cancelAtPeriodEnd    Boolean?
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  seats                Int?
  trialStart           DateTime?
  trialEnd             DateTime?
  billingInterval      String?
  stripeScheduleId     String?
}

model WaitingList {
  id        String    @id
  email     String
  plan      String?
  createdAt DateTime  @db.Timestamp(6)
  deletedAt DateTime? @db.Timestamp(6)
}

/// Issuance/consume store for Access Codes. Entitlement clock lives on
/// synced Stripe Subscription rows, not on this model.
model TrialRedeemCode {
  id        Int                    @id @default(autoincrement())
  code      String                 @unique
  status    TrialRedeemCodeStatus  @default(unused)
  mode      TrialRedeemCodeMode    @default(timed_trial)
  trialDays Int                    @default(14)
  note      String?
  createdAt DateTime               @db.Timestamp(6)
  usedAt    DateTime?              @db.Timestamp(6)
  usedBy    String?

  usedByUser User? @relation(fields: [usedBy], references: [id], onDelete: SetNull)
}

/// App-owned set of Stripe Coupon ids ever used as a campaign Coupon.
/// Classifies a live Subscription Discount as campaign (vs staff). Ids remain
/// after the Campaign Window ends or the Coupon is swapped mid-window.
model CampaignRegistryCoupon {
  couponId  String   @id
  createdAt DateTime @db.Timestamp(6)
}

/// In-app Promotion Code notify write path. One open row per user + Stripe
/// Promotion Code id. Console delivery chrome is out of scope for Adminboard.
model PromotionCodeDelivery {
  id              String                       @id @default(cuid())
  userId          String
  promotionCodeId String
  code            String
  couponId        String
  status          PromotionCodeDeliveryStatus  @default(open)
  createdAt       DateTime                     @db.Timestamp(6)
  updatedAt       DateTime                     @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, promotionCodeId])
  @@index([userId, status])
}

/// Promotion Code entered before first paid Checkout. Open rows are short-lived
/// and used to attach a Promotion Code to the upcoming Stripe Checkout Session.
model PendingPromotionCode {
  id                  String                     @id @default(cuid())
  userId              String
  code                String
  promotionCodeId     String
  couponId            String
  /// Set only when this hold governs a Discount already live on a
  /// Subscription (mid-cycle redeem); null for a pre-Checkout hold. The
  /// live Discount is force-reverted via Stripe when this hold expires.
  liveSubscriptionId  String?
  status              PendingPromotionCodeStatus @default(open)
  expiresAt           DateTime                   @db.Timestamp(6)
  createdAt           DateTime                   @db.Timestamp(6)
  updatedAt           DateTime                   @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
  /// Serves the scheduled cross-user sweep (status + expiresAt, no userId).
  @@index([status, expiresAt])
}

/// At most one scheduled-or-live Campaign Window (singleton row). Subscribe
/// Checkout auto-attaches `couponId` while live and healthy; closing sets
/// `closedAt` and stops new attaches without clearing existing Discounts.
model CampaignWindow {
  id        String    @id
  couponId  String
  startsAt  DateTime  @db.Timestamp(6)
  endsAt    DateTime  @db.Timestamp(6)
  closedAt  DateTime? @db.Timestamp(6)
  createdAt DateTime  @db.Timestamp(6)
  updatedAt DateTime  @db.Timestamp(6)
}
