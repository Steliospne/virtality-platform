# Copy to .env and fill from the team vault when needed.
# See docs/onboarding/README.md

NEXT_PUBLIC_ENV=development
ENV=development

# Same DB as packages/db (required for console proxy / Prisma)
DATABASE_URL=postgresql://devuser:devpass@localhost:5434/devdb

# Optional analytics
# NEXT_PUBLIC_POSTHOG_KEY=

# Optional CDN (image URLs read from server-uploaded content)
# NEXT_PUBLIC_CDN_URL=
