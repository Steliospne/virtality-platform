// Marketing Blog Domain

enum MarketingBlogPostStatus {
  draft
  published
  archived
}

model MarketingBlogAuthor {
  id        String              @id
  name      String
  role      String?
  image     String?
  createdAt DateTime            @default(now()) @db.Timestamp(6)
  updatedAt DateTime            @updatedAt @db.Timestamp(6)
  posts     MarketingBlogPost[]
}

model MarketingBlogPost {
  id                 String                   @id
  status             MarketingBlogPostStatus
  slug               String                   @unique
  title              String
  excerpt            String
  cover              String
  coverFocusY        Int?
  authorId           String
  author             MarketingBlogAuthor      @relation(fields: [authorId], references: [id])
  publishedAt        String?
  featured           Boolean                  @default(false)
  body               Json
  publishedSnapshot  Json?
  slugLocked         Boolean                  @default(false)
  version            Int                      @default(1)
  createdAt          DateTime                 @default(now()) @db.Timestamp(6)
  updatedAt          DateTime                 @updatedAt @db.Timestamp(6)

  @@index([status, publishedAt])
  @@index([status, featured])
}
