{
  "name": "@virtality/nodemailer",
  "version": "0.0.0",
  "description": "Nodemailer for the Virtality platform",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "dev:ethereal": "tsx scripts/ethereal-dev.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@virtality/db": "workspace:*",
    "@virtality/shared": "workspace:*",
    "@virtality/ui": "workspace:*",
    "nodemailer": "8.0.1",
    "open": "^11.0.2"
  },
  "devDependencies": {
    "@types/node": "25.3.3",
    "@types/nodemailer": "7.0.11",
    "@virtality/typescript-config": "workspace:*",
    "tsx": "4.21.0",
    "typescript": "7.0.2"
  }
}
