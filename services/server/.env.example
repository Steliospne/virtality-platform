# Same value as apps/website REVALIDATE_SECRET
REVALIDATE_SECRET=
# Required for getWebsiteUrl() when calling the website revalidate endpoint
NEXT_PUBLIC_ENV=development

# Set to true for container Node listen (local uses ENV=development)
LISTEN=

# Optional additional recipients; info@virtality.app is always notified.
WAITLIST_NOTIFY_EMAIL=

# Customer onboarding booking link used in the welcome email.
WAITLIST_ONBOARDING_URL=https://cal.com/virtality
